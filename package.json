{
  "name": "nimony",
  "displayName": "Nimony",
  "description": "nim language support with nimony as a compiler",
  "version": "0.0.1",
  "publisher": "levovix0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nim",
        "aliases": [
          "Nim",
          "nim"
        ],
        "extensions": [
          ".nim",
          ".nims"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nim",
        "scopeName": "source.nim",
        "path": "./syntaxes/nim.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Nimony",
      "properties": {
        "nimony.path": {
          "type": "string",
          "default": "nimony",
          "description": "Path to compiler (the `nimony` executable, for example, /usr/local/bin/nimony)."
        },
        "nimony.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Check for errors in nim files each time they are saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
